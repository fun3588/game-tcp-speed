{
  "log": {
    "level": "info",
    "timestamp": true,
    "output": "singbox.log"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 2081,
      "set_system_proxy": false
    }
  ],
  "outbounds": [
    // 主订阅节点 (从主订阅自动更新)
    {
      "type": "vless",
      "tag": "主节点-0001 (新加坡)",
      "server": "seekers-extraordinary-suppliers-goals.trycloudflare.com",
      "server_port": 443,
      "uuid": "d3b07384-d113-42a6-a51f-2831f237f37a",
      "packet_encoding": "xudp",
      "tls": {
        "enabled": true,
        "insecure": true,
        "server_name": "seekers-extraordinary-suppliers-goals.trycloudflare.com",
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        }
      },
      "transport": {
        "type": "ws",
        "path": "/mywspath",
        "headers": {
          "Host": "seekers-extraordinary-suppliers-goals.trycloudflare.com"
        }
      }
    },
    // 备订阅节点 (从备订阅自动更新)
    {
      "type": "vless",
      "tag": "备节点-0709 (新加坡)",
      "server": "telescope-costumes-reflected-resident.trycloudflare.com",
      "server_port": 443,
      "uuid": "c993eed9-4317-40fa-bed1-667eec18e30c",
      "packet_encoding": "xudp",
      "tls": {
        "enabled": true,
        "insecure": false,
        "server_name": "telescope-costumes-reflected-resident.trycloudflare.com",
        "alpn": [
          "http/1.1"
        ]
      },
      "transport": {
        "type": "ws",
        "path": "/vless",
        "headers": {
          "Host": "telescope-costumes-reflected-resident.trycloudflare.com"
        }
      }
    },
    {
      "type": "selector",
      "tag": "node",
      "outbounds": [
        "主节点-0001 (新加坡)",
        "备节点-0709 (新加坡)"
