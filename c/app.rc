#define IDI_APP_ICON 101

IDI_APP_ICON ICON "app.ico"

// 版本信息：Windows 资源管理器「属性 → 详细信息」里可见，
// 便于区分已部署的构建版本，避免 DLL 与 GUI 版本错配。
1 VERSIONINFO
FILEVERSION     3,1,0,0
PRODUCTVERSION  3,1,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "GameTcpSpeed"
            VALUE "FileDescription",  "GameTcpSpeed - TCP Game Accelerator (v3.1)"
            VALUE "FileVersion",      "3.1.0.0"
            VALUE "InternalName",     "GameTcpSpeed"
            VALUE "OriginalFilename", "GameTcpSpeed.exe"
            VALUE "ProductName",      "GameTcpSpeed"
            VALUE "ProductVersion",   "3.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
